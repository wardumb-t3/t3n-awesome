{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Terminal-3/awesome-trusted-ai/registry/schema.json",
  "title": "Awesome Trusted AI registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "summary", "url", "pillars", "badge", "added"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must equal the file name without .yml" },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "type": { "enum": ["agent", "workflow", "tool", "demo", "learn"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 200, "description": "One sentence. Lead with what the agent can do safely." },
    "url": { "type": "string", "format": "uri", "description": "Repo, docs or product page" },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", "description": "Source repo, when url is a docs or product page" },
    "uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Demos only: ids of the entries the demo shows in action"
    },
    "works_with": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["any-t3n-agent", "claude", "chatgpt", "gemini", "muse", "copilot"] },
      "description": "AIs that can use this entry today. Listing it makes a workflow or tool a Skill on the Agent Directory."
    },
    "demo_url": { "type": ["string", "null"], "format": "uri" },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["identity", "delegation", "privacy", "spend-control", "egress-control", "human-in-loop", "audit", "credentials"] }
    },
    "stack": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9.+#-]+$" } },
    "runtime": { "enum": ["t3n", "other"], "default": "t3n" },
    "t3n_features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Which T3N capabilities the entry uses, e.g. tenant-contract, vault, sealed-maps, http-placeholders, egress-grant, delegation, agent-credits, t3n-sdk"
    },
    "license": { "type": "string", "description": "Optional. SPDX identifier for open-source projects, or Proprietary" },
    "badge": {
      "enum": ["built-by-t3n", "secured-on-t3n", "none"],
      "description": "secured-on-t3n is granted by maintainers after verification; submitters use none"
    },
    "maintainers": { "type": "array", "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" } },
    "business_function": {
      "enum": ["payroll-hr", "finance-payments", "customer-support", "healthcare", "insurance", "travel-expense", "identity-kyc", "legal-compliance", "others"],
      "description": "Agent Directory categories.slug"
    },
    "pain": { "type": "string", "maxLength": 500, "description": "Directory agents.pain" },
    "protects": { "type": "string", "maxLength": 500, "description": "Directory agents.protect_summary" },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "enclave", "agent"],
      "properties": {
        "source": { "type": "string" },
        "enclave": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "did": { "type": ["string", "null"], "pattern": "^did:" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "website": { "type": "string", "format": "uri" } }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Technical detail for workflows",
      "properties": {
        "wit_world": { "type": "string" },
        "version": { "type": "string" },
        "wasm_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "added": { "type": "string", "format": "date" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "agent" } } }, "then": { "required": ["business_function"] } },
    { "if": { "properties": { "type": { "not": { "const": "demo" } } } }, "then": { "not": { "required": ["uses"] } } },
    {
      "$comment": "Demos, workflows, tools and agents must be built on T3N. Learn resources may cover any stack.",
      "if": { "properties": { "type": { "enum": ["agent", "workflow", "tool", "demo"] } } },
      "then": {
        "required": ["runtime", "t3n_features"],
        "properties": { "runtime": { "const": "t3n" }, "t3n_features": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "badge": { "const": "secured-on-t3n" } } },
      "then": { "required": ["contract"], "properties": { "contract": { "type": "object", "required": ["wasm_sha256"] }, "runtime": { "const": "t3n" } } }
    }
  ]
}
